# Node & Package Managers
/node_modules
/.pnpm-store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js Build Output
/.next/
/out/
/build
/dist

# Target Directory Exception
# Ignores Rust/Anchor build binaries while preserving generated TypeScript types & IDL files for Vercel
/target/*
!/target/types/
!/target/idl/

# Environment Files & Secrets
.env
.env*.local
!.env.example

# Testing Output & Coverage
/coverage
/.nyc_output

# IDE, OS, & System Artifacts
.DS_Store
Thumbs.db
*.pem
.vscode/
!.vscode/settings.json
.idea/

# Vercel Deployment Artifacts
.vercel